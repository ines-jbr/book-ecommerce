<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Book Ecommerce{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.1em%22 font-size=%2296%22>🌸</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Quicksand:wght@400;500;600;700&family=Dancing+Script:wght@600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a href="{{ path('app_livre_index') }}" class="logo">🌸 Book&nbsp;<span>Boutique</span></a>
            <nav>
                <a href="{{ path('app_livre_index') }}">Catalogue</a>
                {% if app.user %}
                    {% if is_granted('ROLE_VENDEUR') %}
                        <a href="{{ path('app_livre_new') }}">Ajouter un livre</a>
                    {% endif %}
                    <a href="{{ path('app_panier_index') }}">🛒 Panier</a>
                    <a href="{{ path('app_logout') }}">Déconnexion ({{ app.user.email }})</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </nav>
        </header>
        <main>
            {% for message in app.flashes('success') %}
                <div class="flash-success">{{ message }}</div>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer">
            <p>Book Boutique — un cocon de lecture 🌷</p>
        </footer>
    </body>
</html>