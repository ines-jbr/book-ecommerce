{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
<h1>Notre catalogue</h1>
<p class="subtitle">une sélection choisie avec amour</p>

<a href="{{ path('app_livre_new') }}" class="btn">+ Ajouter un livre</a>

{% if livres is empty %}
    <div class="empty-state">
        <p>🌷 Aucun livre disponible pour le moment.</p>
    </div>
{% else %}
    <div class="book-grid">
        {% for livre in livres %}
            <div class="book-card">
                <h3>{{ livre.titre }}</h3>
                <p class="author">{{ livre.auteur }}</p>
                <p class="price">{{ livre.prix }} €</p>
                <p class="stock {{ livre.stock == 0 ? 'out' : '' }}">
                    {% if livre.stock == 0 %}
                        Rupture de stock
                    {% else %}
                        {{ livre.stock }} en stock
                    {% endif %}
                </p>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}