{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<h1>Mon panier</h1>
<p class="subtitle">vos trouvailles du moment</p>

{% if lignes is empty %}
    <div class="empty-state">
        <p>🛍️ Votre panier est vide pour le moment.</p>
        <a href="{{ path('app_livre_index') }}" class="btn">Découvrir le catalogue</a>
    </div>
{% else %}
    <div class="panier-lignes">
        {% for ligne in lignes %}
            <div class="panier-ligne">
                <div class="panier-ligne-cover">
                    {% if ligne.livre.image %}
                        <img src="{{ asset('uploads/livres/' ~ ligne.livre.image) }}" alt="Couverture de {{ ligne.livre.titre }}">
                    {% else %}
                        <div class="no-cover">📖</div>
                    {% endif %}
                </div>

                <div class="panier-ligne-info">
                    <h3>{{ ligne.livre.titre }}</h3>
                    <p class="author">{{ ligne.livre.auteur }}</p>
                    <p class="price">{{ ligne.livre.prix }} € / unité</p>
                </div>

                <form method="post" action="{{ path('app_panier_modifier', {id: ligne.livre.id}) }}" class="panier-quantite-form">
                    <label for="quantite-{{ ligne.livre.id }}">Quantité</label>
                    <input
                        type="number"
                        id="quantite-{{ ligne.livre.id }}"
                        name="quantite"
                        value="{{ ligne.quantite }}"
                        min="1"
                        max="{{ ligne.livre.stock }}"
                    >
                    <button type="submit" class="btn-small">Mettre à jour</button>
                </form>

                <p class="panier-sous-total">{{ ligne.sousTotal }} €</p>

                <form method="post" action="{{ path('app_panier_retirer', {id: ligne.livre.id}) }}">
                    <button type="submit" class="btn-remove" title="Retirer du panier">✕</button>
                </form>
            </div>
        {% endfor %}
    </div>

    <div class="panier-total">
        <p>Total : <strong>{{ total }} €</strong></p>
        <a href="#" class="btn">Passer la commande</a>
    </div>
{% endif %}
{% endblock %}